    "sidebar_heading_shadow": "#00000000",
    "status_bar_label_shadow": "#00000000",
    "button_label_shadow": "#00000000"
  },
  "rules": [
    {
      "class": "sidebar_tree",
      "indent": 16,
      "indent_offset": 12,
      "row_padding": [
        16,
        4,
        8,
        4
      ],
      "spacer_rows": false
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_label",
      "font.size": 14,
      "shadow_color": "#00000000"
    },
    {
      "class": "title_bar",
      "style": "dark"
    },
    {
      "class": "tabset_control",
      "layer0.tint": "#21201E",
      "layer0.opacity": 1.0
    },
    {
      "class": "tab_control",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "#191817",
      "layer0.opacity": 1.0
    }
  ]
}
